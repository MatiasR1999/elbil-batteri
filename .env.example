# Public application URL. Use http://localhost:3000 locally and the Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon is the target database for the product. The Vercel integration creates
# these automatically for preview and production deployments.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Managed Neon Auth (Better Auth). Generate a random secret of at least 32 characters.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.eu-central-1.aws.neon.tech
NEON_AUTH_COOKIE_SECRET=replace_with_at_least_32_random_characters

# Temporary legacy settings used only by /lab while the Smartcar proof is
# migrated to Neon. Remove these after the cutover described in docs/NEON_MIGRATION.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy projects may set NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Smartcar Connect application identifier
SMARTCAR_APPLICATION_ID=replace_me

# Smartcar v3 API credentials (OAuth 2.0 client credentials)
SMARTCAR_CLIENT_ID=replace_me
SMARTCAR_CLIENT_SECRET=replace_me

# Smartcar webhook Application Management Token
SMARTCAR_MANAGEMENT_TOKEN=replace_me

# Must exactly match a redirect URI configured in the Smartcar Dashboard.
SMARTCAR_REDIRECT_URI=http://localhost:3000/api/smartcar/callback

# Default to simulated until the complete flow is verified.
SMARTCAR_CONNECT_MODE=simulated
